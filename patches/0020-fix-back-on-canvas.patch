+    // Returns whether this is a teleport Essentials cares about.
+    private boolean handleTeleport(final Player player, final Location from, final TeleportCause cause) {
+        if (player.hasMetadata("NPC") || !(cause == TeleportCause.PLUGIN || cause == TeleportCause.COMMAND)) {
+            return false;
+        }
+
+        final User user = ess.getUser(player);
+        if (ess.getSettings().registerBackInListener() && user.isAuthorized("essentials.back.onteleport")) {
+            user.setLastLocation(from);
+        }
+        if (ess.getSettings().isTeleportInvulnerability()) {
+            user.enableInvulnerabilityAfterTeleport();
+        }
+        return true;
+    }
+
+    private final class RegionizedEventHandler implements RegionizedEventListenerProvider.Handler {
+        @Override
+        public void onPostTeleport(final Player player, final Location from, final Location to, final TeleportCause cause) {
+            // The flight mitigation of onPlayerTeleport isn't applied here: it records the flight state of the player
+            // before the world change, which has already happened by the time this event is fired.
+            handleTeleport(player, from, cause);
+        }
+
+        @Override
+        public void onPostRespawn(final Player player, final Location respawnLocation) {
+            handleRespawn(ess.getUser(player));
+        }
+    }
