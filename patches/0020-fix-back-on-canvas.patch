diff --git a/providers/BaseProviders/src/main/java/net/ess3/provider/RegionizedEventListenerProvider.java b/providers/BaseProviders/src/main/java/net/ess3/provider/RegionizedEventListenerProvider.java
new file mode 100644
index 0000000000000000000000000000000000000000..33aeeca6cd46f556281abdde98e8a886fdc4f480
--- /dev/null
+++ b/providers/BaseProviders/src/main/java/net/ess3/provider/RegionizedEventListenerProvider.java
@@ -0,0 +1,24 @@
+package net.ess3.provider;
+
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.bukkit.event.Listener;
+import org.bukkit.event.player.PlayerTeleportEvent;
+
+public abstract class RegionizedEventListenerProvider implements Provider, Listener {
+    private final Handler handler;
+
+    protected RegionizedEventListenerProvider(final Handler handler) {
+        this.handler = handler;
+    }
+
+    protected final Handler handler() {
+        return handler;
+    }
+
+    public interface Handler {
+        void onPostTeleport(Player player, Location from, Location to, PlayerTeleportEvent.TeleportCause cause);
+
+        void onPostRespawn(Player player, Location respawnLocation);
+    }
+}
