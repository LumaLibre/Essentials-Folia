index 0000000000000000000000000000000000000000..5fade9c19e71d7c45b2d1e7cefe2266ed5610fba
--- /dev/null
+++ b/providers/CanvasProvider/src/main/java/net/ess3/provider/providers/CanvasRegionizedEventListenerProvider.java
@@ -0,0 +1,28 @@
+package net.ess3.provider.providers;
+
+import io.canvasmc.canvas.event.EntityPostTeleportAsyncEvent;
+import io.canvasmc.canvas.event.PlayerPostRespawnAsyncEvent;
+import net.ess3.provider.RegionizedEventListenerProvider;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+
+public class CanvasRegionizedEventListenerProvider extends RegionizedEventListenerProvider {
+    public CanvasRegionizedEventListenerProvider(final Handler handler) {
+        super(handler);
+    }
+
+    @EventHandler(priority = EventPriority.HIGH)
+    public void onPostTeleport(final EntityPostTeleportAsyncEvent event) {
+        if (!(event.getEntity() instanceof Player)) {
+            return;
+        }
+
+        handler().onPostTeleport((Player) event.getEntity(), event.getFrom(), event.getTo(), event.getCause());
+    }
+
+    @EventHandler(priority = EventPriority.NORMAL)
+    public void onPostRespawn(final PlayerPostRespawnAsyncEvent event) {
+        handler().onPostRespawn(event.getPlayer(), event.getRespawnLocation());
+    }
+}
