diff --git a/providers/CanvasProvider/src/main/java/net/ess3/provider/providers/CanvasRegionizedEventListenerProvider.java b/providers/CanvasProvider/src/main/java/net/ess3/provider/providers/CanvasRegionizedEventListenerProvider.java
